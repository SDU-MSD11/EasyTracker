# Copy to .env:  cp .env.example .env
# Android emulator -> host loopback is 10.0.2.2, e.g. BASE_URL=http://10.0.2.2:3000
# Physical device on same LAN -> use host LAN IP, e.g. BASE_URL=http://192.168.1.50:3000
#   (IP:PORT of the machine running `npm run dev`; PORT must match below.)

PGHOST=localhost
PGPORT=5432
PGUSER=easytracker
PGPASSWORD=changeme
PGDATABASE=easytracker
PGSSL=false
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000
